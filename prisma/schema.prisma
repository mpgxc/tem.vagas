generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String       @id @default(uuid())
  name          String
  full_name     String
  email         String       @unique
  avatar        String?
  password      String
  role          Role
  document      String       @unique
  document_type DocumentType
  phone_number  String       @unique
  bio           String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  advertisement Advertisement[]

  @@map("customers")
}

model Advertisement {
  id           String             @id @default(uuid())
  title        String
  description  String
  location     String
  price        Decimal            @db.Decimal(10, 2)
  bedrooms     Int
  bathrooms    Int
  garage       Int
  area         Float
  slug         String             @unique
  is_furnished Boolean
  image_urls   String[]
  status       AnnouncementStatus
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  address Address?

  @@map("advertisements")
}

model Address {
  id         String   @id @default(uuid())
  street     String
  number     String
  city       String
  state      String
  zip_code   String
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  advertisement   Advertisement @relation(fields: [advertisementId], references: [id])
  advertisementId String        @unique

  @@map("addresses")
}

model Notification {
  id        String   @id @default(uuid())
  content   String
  timestamp DateTime @default(now())

  sender_id   String
  receiver_id String
  property_id String?

  @@map("notifications")
}

model Leads {
  id      String @id @default(uuid())
  email   String @unique
  name    String
  phone   String @unique
  message String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("leads")
}

enum Role {
  Corretor
  Proprietario
  Imobiliaria
  Inquilino
  Administrador
}

enum AnnouncementStatus {
  Disponivel
  Alugado
  Pausado
  Vendido
  Expirado
}

enum DocumentType {
  CPF
  CNPJ
}
